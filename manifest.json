{
  "manifest_version": 3,
  "name": "API to Postman",
  "version": "0.1.1",
  "description": "Capture network requests from Chrome DevTools and export Postman collections.",
  "minimum_chrome_version": "116",
  "permissions": ["debugger", "storage"],
  "host_permissions": ["https://api.postman.com/*"],
  "background": {
    "service_worker": "dist/background/service-worker.js",
    "type": "module"
  },
  "devtools_page": "dist/devtools.html"
}
